(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r157.5_157.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 157500)
            (height 157500)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c157.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 78750
            (pt 0 0)
          )
        )
      )
      (pad c65
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 32500
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r157.5_157.5h105
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 52500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r157.5_157.5))
          (noconnect (pad r157.5_157.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r157.5_157.5))
          (noconnect (pad r157.5_157.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r157.5_157.5))
          (noconnect (pad r157.5_157.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad r157.5_157.5))
          (connect (pad r157.5_157.5))
          (noconnect (pad r157.5_157.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad r157.5_157.5))
          (noconnect (pad r157.5_157.5))
        )
      )
      (padstack c157.5h105
