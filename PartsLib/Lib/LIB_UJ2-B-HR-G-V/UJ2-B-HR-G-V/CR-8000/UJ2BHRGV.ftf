(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c147.8
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 73900
            (pt 0 0)
          )
        )
      )
      (pad r147.8_147.8
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 147800)
            (height 147800)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c345
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 172500
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c147.8h95
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 47500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c147.8))
          (noconnect (pad c147.8))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c147.8))
          (noconnect (pad c147.8))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c147.8))
          (noconnect (pad c147.8))
        )
        (padSet (footLayer Inner)
          (clearance (pad c147.8))
          (connect (pad c147.8))
          (noconnect (pad c147.8))
        )
        (padSet (footLayer Bottom)
          (connect (pad c147.8))
          (noconnect (pad c147.8))
        )
      )
      (padstack r147.8_147.8h95
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 47500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r147.8_147.8))
          (noconnect (pad r147.8_147.8))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r147.8_147.8))
          (noconnect (pad r147.8_147.8))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r147.8_147.8))
          (noconnect (pad r147.8_147.8))
        )
        (padSet (footLayer Inner)
          (clearance (pad r147.8_147.8))
          (connect (pad r147.8_147.8))
          (noconnect (pad r147.8_147.8))
        )
        (padSet (footLayer Bottom)
          (connect (pad r147.8_147.8))
          (noconnect (pad r147.8_147.8))
        )
      )
      (padstack c345h230
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 115000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Inner)
          (clearance (pad c345))
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Bottom)
          (connect (pad c345))
          (noconnect (pad c345))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "UJ2BHRGV"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -727000 367000
                        (width 10000)
                      )
                      (pt 477000 367000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 477000 367000
                        (width 10000)
                      )
                      (pt 477000 -733000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 477000 -733000
                        (width 10000)
                      )
                      (pt -727000 -733000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -727000 -733000
                        (width 10000)
                      )
                      (pt -727000 367000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 749500 467000)
                    (pt 749500 -833000)
                    (pt -999500 -833000)
                    (pt -999500 467000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 477000 -433000
                        (width 20000)
                      )
                      (pt 477000 -733000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 477000 -733000
                        (width 20000)
                      )
                      (pt -727000 -733000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -727000 -733000
                        (width 20000)
                      )
                      (pt -727000 -433000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -727000 67000
                        (width 20000)
                      )
                      (pt -727000 367000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -727000 367000
                        (width 20000)
                      )
                      (pt 477000 367000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 477000 367000
                        (width 20000)
                      )
                      (pt 477000 67000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 0 420000
                        (width 10000)
                      )
                      (pt 0 420000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 420000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt 0 430000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 430000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt 0 420000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack r147.8_147.8h95))
                )
              )
            )
          )
          (pin 2
            (pt -250000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -250000 0)
                  (angle 90)
                  (padstackGroup default (padstack c147.8h95))
                )
              )
            )
          )
          (pin 3
            (pt -250000 -320000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -250000 -320000)
                  (angle 90)
                  (padstackGroup default (padstack c147.8h95))
                )
              )
            )
          )
          (pin 4
            (pt 0 -320000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -320000)
                  (angle 90)
                  (padstackGroup default (padstack c147.8h95))
                )
              )
            )
          )
          (pin MH1
            (pt -727000 -250000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -727000 -250000)
                  (angle 90)
                  (padstackGroup default (padstack c345h230))
                )
              )
            )
          )
          (pin MH2
            (pt 477000 -250000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 477000 -250000)
                  (angle 90)
                  (padstackGroup default (padstack c345h230))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape UJ2-B-HR-G-V.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

