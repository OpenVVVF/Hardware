	(text "hw ocp not needed, see HARA for addt'l info\ndesat + redundant adc current sense determined to be acceptable\n\nSafe Torque Off can be achieved within 100mS\nwithout OCP comparators\n\nBoth STM MCUs have hw analog watchdogs that\nachieve the same function"
		(exclude_from_sim no)
		(at 106.934 175.006 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "06020b60-f070-464c-8703-d005345c36ac")
	)
	(text "bootsel switch, push for bootloader"
		(exclude_from_sim no)
		(at 98.044 17.526 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0f4187e9-df93-4039-accd-dd470b4becd8")
	)
	(text "Onboard temperature sensing\nMonitors ambient board,\ninverter housing temperature"
		(exclude_from_sim no)
		(at 260.096 36.576 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "13f7d74d-0221-45df-b2f3-e3df487a329d")
	)
	(text "Inter-mcu UART\nalso runs challenge/response watchdog"
		(exclude_from_sim no)
		(at 131.318 57.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "59d7f77b-b6a4-469e-bdf6-af7bc4429ae1")
	)
	(text "For multidrive operation, hardware supports fiber ring\nbus for Distributed Drive Communication (DDC). IO Board\nwill need to be variant that has fiber in and out\n\nEnables power stage parallel operation or 6+ phase drives."
		(exclude_from_sim no)
		(at 236.474 134.112 0)
		(effects
			(font
				(size 0.889 0.889)
			)
		)
		(uuid "68409877-a313-4c21-89ff-dc869a61b353")
	)
	(text "Safety coprocessor added as intent to target ASIL B(D) + ASIL B(D)\nNote: ASIL-B requires STM's SIL library which we cannot include here (propreitary)\nAs such, this makes the approach a best-effort attempt.\nAdditionally, no formal safety analysis by an independent agency has been performed."
		(exclude_from_sim no)
		(at 27.686 159.258 90)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7c21dc5e-98b1-4e49-97ed-09f03837edb8")
	)
	(text "Power monitoring, SIL-3 compliant system\nIndependently monitors and can trigger fault on power brownout\nSolves risk of common power rail to Main MCU + Safety Coproc causing failure in both"
		(exclude_from_sim no)
		(at 224.028 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7edf0db0-4abc-4ce6-b595-bf1f9c624279")
	)
	(text "reset switch, push to reset"
		(exclude_from_sim no)
		(at 212.852 19.05 0)
