	(text "Connector to IO board\nProvides dual fully isolated canbus interfaces\n(isolated from each-other as well)\n60v tolerant"
		(exclude_from_sim no)
		(at 111.252 134.366 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8aeb97b6-5584-4222-9c1b-ca1a9f3f6f7f")
	)
	(text "voltage sense connector\nISOLATED, HIGH VOLTAGE!"
		(exclude_from_sim no)
		(at 21.844 152.146 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "91b779ac-83d9-40ad-b500-a81cd4b20140")
	)
	(text "CONNECTOR FROM THIS GATE DRIVER\nTO MAIN CONTROL BOARD BELOW"
		(exclude_from_sim no)
		(at 54.102 48.514 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9f7976d7-0ec6-4010-9285-2635b1279982")
	)
	(text "Control system has dual independent mcus,\ntargeting ASIL decomposition.\nIndependently monitored switching commands,\ncurrent responses, canbus commands + faults\n\nPlease see HARA under documentation for additional informaton."
		(exclude_from_sim no)
		(at 174.752 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b6060a63-2c53-476e-8f1d-c486ad49c57b")
	)
	(text "Connector from gate drivers\n\nIncludes multiple redundant SSO (six-switch-off) pathways:\n - via gate drive reset\n - via gate drive power enable 1\n - via gate drive power enable 2\n\n(Gate driver power enable \nimplemnts 1oo2, with monitoring \nfeedback)."
		(exclude_from_sim no)
		(at 3.81 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b83412a6-d9dc-42da-9dd5-de7340a86e76")
	)
	(text "onboard power regulator section, for 3.3v mcu power, +5v current sense, etc"
		(exclude_from_sim no)
		(at 75.946 174.498 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cbf04dbb-15f4-4294-9fcd-1e08c56b9b9d")
	)
	(text "feedback pins are 0-3.3v binary\n(3.3v expected when +12v present)"
